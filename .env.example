# PostgreSQL connection. Set real values in an untracked .env file.
DB_URL=jdbc:postgresql://localhost:5432/codepath_academy
DB_USERNAME=codepath_academy
DB_PASSWORD=change-me

# Web origins are comma-separated. Production should use the deployed academy origin only.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_COOKIE_SECURE=false

# Bootstrap is disabled by default. Enable once, provision the first administrator, then disable.
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=

# GitHub curriculum source (the importer pins an immutable commit before importing).
APP_CURRICULUM_REPOSITORY=felix202422/CodePath-Masterclass

# Local development media directory; production storage is configurable separately.
APP_MEDIA_ROOT=./data/media

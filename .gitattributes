# Normalize line endings to LF in the repository; keep native endings on checkout.
* text=auto

# Explicit text types (unambiguous, tooling-friendly).
*.java   text eol=lf
*.kt     text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.xml    text eol=lf
*.sql    text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.svg    text eol=lf
*.txt    text eol=lf
*.conf   text eol=lf
Dockerfile text eol=lf

# Shell scripts must be LF even on Windows checkouts.
*.sh     text eol=lf

# Windows entry points keep CRLF.
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Binary assets: never normalize.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.gif    binary
*.ico    binary
*.avif   binary
*.pdf    binary
*.zip    binary
*.gz     binary
*.jar    binary
*.woff   binary
*.woff2  binary
*.ttf    binary

# Diff noise reduction.
*.lock   linguist-generated=false
frontend/package-lock.json linguist-generated
